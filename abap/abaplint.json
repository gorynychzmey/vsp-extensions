{
  "global": {
    "files": "/src/**/*.*",
    "exclude": [],
    "noIssues": []
  },
  "dependencies": [
    {
      "url": "https://github.com/abaplint/deps",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/oisee/vibing-steampunk",
      "folder": "/zadt_vsp",
      "files": "/src/**/*.*"
    },
    {
      "folder": "/stubs",
      "files": "/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "^(Z|Y|LCL_|TY_|LIF_)"
  },
  "rules": {
    "parser_error": true,
    "check_syntax": true,
    "unknown_types": true
  }
}
